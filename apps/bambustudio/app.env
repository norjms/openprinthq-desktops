# Bambu Studio's settings for the shared start-up steps (common/files/s6). Read as shell by init-ahi-app,
# init-ahi-files and svc-ahi-inbox.
APP_TITLE="Bambu Studio"
APP_CONF=/config/.config/BambuStudio/BambuStudio.conf
APP_CONF_NEW='{\n\t"app": {\n\t\t"dark_color_mode": "1"\n\t}\n}\n'
APP_SINGLE_INSTANCE=json
APP_FILES_DEFAULTS=json
APP_PROCESS=/opt/bambustudio/bin/bambu-studio
APP_RUN=/opt/bambustudio/AppRun
