#!/usr/bin/with-contenv bash
# OpenPrintHQ (B49): opens what the farm sends to this desktop. The installer mounts this desktop's inbox at
# "From the farm" in Files; the farm writes the file there, then a marker ".open-<file name>". Each marker is
# taken once: the file opens in the app already running (single instance, init-ahi-app), or starts it when it
# has not been running for a while. A file sent while the desktop was stopped opens when it starts. The app is
# named by /etc/ahi/app.env (APP_PROCESS to find it running, APP_RUN to start it).
source /etc/ahi/app.env
FILES="${FILE_MANAGER_PATH:-/config/Files}"
INBOX="${FILES}/From the farm"
RUNTIME="${XDG_RUNTIME_DIR:-/config/.XDG}"
if [[ ! -d "${INBOX}" || -z "${APP_RUN:-}" ]]; then
  # No inbox mounted, or an app that cannot open a file it is given: nothing to watch.
  exec sleep infinity
fi
export HOME=/config XDG_RUNTIME_DIR="${RUNTIME}" NO_AT_BRIDGE=1
export DBUS_SESSION_BUS_ADDRESS="unix:path=${RUNTIME}/ahi-bus"
if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]]; then
  export WAYLAND_DISPLAY=wayland-1 DISPLAY=:0
  display_up() { [[ -S "${RUNTIME}/${WAYLAND_DISPLAY}" ]]; }
else
  export DISPLAY="${DISPLAY:-:0}"
  display_up() { [[ -S "/tmp/.X11-unix/X${DISPLAY#:}" ]]; }
fi
started=$(date +%s)
app_running() { pgrep -u abc -f "${APP_PROCESS}" >/dev/null; }
while true; do
  sleep 2
  shopt -s nullglob
  markers=("${INBOX}"/.open-*)
  shopt -u nullglob
  (( ${#markers[@]} )) || continue
  # Until the desktop is up, sent files wait: they open once someone opens it.
  display_up || { started=$(date +%s); continue; }
  # Wait for the app's own start, so a sent file joins its window rather than racing it; after a minute
  # without one (closed by the person), the file starts one.
  if ! app_running && (( $(date +%s) - started < 60 )); then
    continue
  fi
  for marker in "${markers[@]}"; do
    name="${marker##*/.open-}"
    rm -f "${marker}"
    file="${INBOX}/${name}"
    [[ "${name}" != */* && -f "${file}" && ! -L "${file}" ]] || continue
    echo "[ahi-inbox] opening ${name} in ${APP_TITLE}"
    s6-setuidgid abc ${APP_RUN} "${file}" >/dev/null 2>&1 &
  done
done
